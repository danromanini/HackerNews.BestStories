{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BestStories": {
    "HackerNews": {
      "BaseAddress": "https://hacker-news.firebaseio.com/v0/",
      "AttemptTimeout": "00:00:05",
      "MaxRetryAttempts": 3
    },
    "Refresh": {
      "Interval": "00:01:00",
      "RetryDelay": "00:00:05",
      "ColdStartTimeout": "00:00:15",
      "MaxConcurrency": 8,
      "MaxStories": 200
    },
    "RateLimiting": {
      "PermitLimit": 100,
      "Window": "00:00:10"
    }
  }
}
